# The doris-rs binary under test. By default it is expected to listen on the host machine with
# the stock Doris ports; the runner reaches it through Docker's host alias. When doris-rs ships
# its own container, point FE_HOST at that service on the oracle network instead.
FE_HOST=host.docker.internal
FE_QUERY_PORT=9030
FE_HTTP_PORT=8030
FE_RPC_PORT=9020
