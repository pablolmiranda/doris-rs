# The doris-rs binary under test: a single native process on this host, started outside Docker,
# listening on the stock Doris ports. The containerized runner reaches it through Docker's host
# alias. doris-rs is never containerized; only the oracle's reference cluster and runner are.
FE_HOST=host.docker.internal
FE_QUERY_PORT=9030
FE_HTTP_PORT=8030
FE_RPC_PORT=9020
