# doris-rs as the BE of the FE-only cluster (compose/fe-only.yml): the reference image's FE in a
# container, doris-rs running natively on this host (never containerized) and registered as the
# only backend by `make fe-up`. The runner and the MySQL tap join the FE container's network
# namespace, as for reference-single, so 127.0.0.1 is the FE.
FE_HOST=127.0.0.1
FE_QUERY_PORT=9030
FE_HTTP_PORT=8030
FE_RPC_PORT=9020
TARGET_NETWORK=container:doris-oracle-fe-only
FE_CONTAINER=doris-oracle-fe-only
FACTS=clusters/rust.facts.json
