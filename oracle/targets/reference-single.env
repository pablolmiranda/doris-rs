# The C++ reference cluster from compose/reference-single.yml: FE and BE share one container and
# the BE registers as 127.0.0.1. The runner therefore joins that container's network namespace,
# so 127.0.0.1 is Doris and FE stream-load redirects to the BE resolve correctly.
FE_HOST=127.0.0.1
FE_QUERY_PORT=9030
FE_HTTP_PORT=8030
FE_RPC_PORT=9020
TARGET_NETWORK=container:doris-oracle-doris-1
