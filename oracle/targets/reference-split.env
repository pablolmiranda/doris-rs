# Reference cluster B from compose/reference-split.yml: FE and BE in separate containers on their
# own network, the BE deployed with other facts on purpose (clusters/split.facts.json).
FE_HOST=fe
FE_QUERY_PORT=9030
FE_HTTP_PORT=8030
FE_RPC_PORT=9020
TARGET_NETWORK=doris-oracle-split
FE_CONTAINER=doris-oracle-split-fe-1
BE_CONTAINER=doris-oracle-split-be-1
FACTS=clusters/split.facts.json
