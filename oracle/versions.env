# Pinned versions for the oracle harness. Change both together: the suites in the source tree
# must match the server they run against, or the baseline measures version skew instead of
# implementation differences.

# Upstream release tag whose regression suites and docker tooling we use.
DORIS_SRC_TAG=4.1.5-release
# Doris version string used for image tags.
DORIS_VERSION=4.1.5
# Reference server image. Built locally by `make image` from the official fe-/be-/ms- component
# images using the upstream all-in-one Dockerfile. Override with DORIS_IMAGE=... to use a
# published tag such as apache/doris:all-in-one-4.1.3 (then expect version skew in the baseline).
DORIS_IMAGE=apache/doris:all-in-one-4.1.5
# Runner image: JDK 17 + Maven, required by the Groovy regression framework.
RUNNER_BASE=maven:3.9-eclipse-temurin-17
RUNNER_IMAGE=doris-rs/oracle-runner:17
# Docker network shared by the reference cluster and the runner.
ORACLE_NETWORK=doris-oracle
